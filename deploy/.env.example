# Copy to ~/referral/deploy/.env on the server and fill in. Never commit the real file.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=referral.flexiflow.tech,backend,localhost,127.0.0.1
FRONTEND_URL=https://referral.flexiflow.tech

# First admin, created on start only if no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: real email for password resets (otherwise they go to the container log)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=CraftFlow Referrals <no-reply@flexiflow.tech>
